	"item": [
		{
			"name": "Authentication (Helpers)",
			"item": [
				{
					"name": "Get Mock Customer Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.access_token) {",
									"    pm.collectionVariables.set(\"customer_token\", response.access_token);",
									"    console.log(\"Saved customer_token: \", response.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/token?role=customer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"token"
							],
							"query": [
								{
									"key": "role",
									"value": "customer"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Mock Admin Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.access_token) {",
									"    pm.collectionVariables.set(\"admin_token\", response.access_token);",
									"    console.log(\"Saved admin_token: \", response.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/token?role=admin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"token"
							],
							"query": [
								{
									"key": "role",
									"value": "admin"
								}
							]
						}
					},
					"response": []
				}
			]
		},
